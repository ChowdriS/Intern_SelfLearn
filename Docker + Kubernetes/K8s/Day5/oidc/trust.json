{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Federated": "arn:aws:iam::590852515231:oidc-provider/s3.us-east-1.amazonaws.com/chow3-bucket-022"
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
                "StringEquals": {
                    "s3.us-east-1.amazonaws.com/chow3-bucket-022:sub": "system:serviceaccount:default:s3-reader-sa"
                }
            }
        }
    ]
}
            },
            "tenancy": "default",
            "timeouts": null,
            "user_data": "#!/bin/bash\n\nsudo yum update -y\nsudo yum install -y mariadb105-server\n\nsudo systemctl enable --now mariadb\n\nmkdir -p /etc/my.cnf.d\ncat \u003e /etc/my.cnf.d/remote.cnf \u003c\u003cEOF\n[mysqld]\nbind-address = 0.0.0.0\nEOF\n\nsystemctl restart mariadb\n\nmysql -e \"CREATE DATABASE IF NOT EXISTS \\`exampledb\\`;\"\nmysql -e \"CREATE USER IF NOT EXISTS 'exampleuser'@'%' IDENTIFIED BY 'examplepass';\"\nmysql -e \"GRANT ALL PRIVILEGES ON \\`exampledb\\`.* TO 'exampleuser'@'%';\"\nmysql -e \"FLUSH PRIVILEGES;\"\n",
            "user_data_base64": null,
            "user_data_replace_on_change": false,

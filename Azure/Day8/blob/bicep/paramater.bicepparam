using './template.bicep'

param location = 'eastus'
param storageAccountName = 'chow3sausingbicep'
param accountType = 'Standard_RAGRS'
param kind = 'StorageV2'
param minimumTlsVersion = 'TLS1_2'
param supportsHttpsTrafficOnly = true
param allowBlobPublicAccess = true
param allowSharedKeyAccess = true
param defaultOAuth = false
param accessTier = 'Hot'
param publicNetworkAccess = 'Enabled'
param allowCrossTenantReplication = false
param networkAclsBypass = 'AzureServices'
param networkAclsDefaultAction = 'Allow'
param networkAclsIpRules = []
param networkAclsIpv6Rules = []
param publishIpv6Endpoint = false
param dnsEndpointType = 'Standard'
param largeFileSharesState = 'Enabled'
param keySource = 'Microsoft.Storage'
param encryptionEnabled = true
param keyTypeForTableAndQueueEncryption = 'Account'
param infrastructureEncryptionEnabled = false
param isBlobSoftDeleteEnabled = true
param blobSoftDeleteRetentionDays = 7
param isContainerSoftDeleteEnabled = true
param containerSoftDeleteRetentionDays = 7
param isShareSoftDeleteEnabled = true
param shareSoftDeleteRetentionDays = 7
